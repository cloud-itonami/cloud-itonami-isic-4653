{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Like the fuel-wholesale / metal-wholesale / agri-wholesale / tech-
 ;; wholesale siblings, this agricultural-machinery-wholesale vertical is
 ;; SELF-CONTAINED: there is no `kotoba-lang/agmachtrade` to delegate
 ;; certification validation to, so the credit-clearance / contract-on-
 ;; file / emissions-certification / ROPS-certification / sanctions-
 ;; screening checks live as direct entity boolean reads in
 ;; `agmachtrade.governor` rather than wrapping an external lib. This repo
 ;; is standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork should
 ;; override them with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        ;; jp-go-dds -- the workspace's BASE design system (root CLAUDE.md,
        ;; 2026-08-05). `agmachtrade.render-html` inlines
        ;; `jp-go-dds.skin/dds+skin` into the generated operator console so
        ;; the page has no external stylesheet fetch. Git coordinate (not
        ;; :local/root) so the render-html build also works in a standalone
        ;; fork outside the monorepo checkout.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "agmachtrade.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html through the REAL actor stack
  ;; (flagship checklist item 2, ADR-2607189300). THROWS if the run
  ;; produces no HARD governor hold, if fewer than nine distinct HARD
  ;; rules fire, or if the emissions/ROPS type-gating control pair stops
  ;; holding -- see agmachtrade.render-html.
  :render-html {:main-opts ["-m" "agmachtrade.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
